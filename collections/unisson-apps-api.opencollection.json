{
  "opencollection": "1.0.0",
  "info": {
    "name": "Unisson agent-evals apps API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "apps",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Templates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/apps/templates",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List Templates"
        },
        {
          "info": {
            "name": "List Apps",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/apps",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List Apps"
        },
        {
          "info": {
            "name": "Get App",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/apps/:app_id",
            "params": [
              {
                "name": "app_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get App"
        },
        {
          "info": {
            "name": "Update App",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v1/apps/:app_id",
            "params": [
              {
                "name": "app_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update App"
        },
        {
          "info": {
            "name": "Delete App",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/apps/:app_id",
            "params": [
              {
                "name": "app_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete App"
        },
        {
          "info": {
            "name": "Get App Readme",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/apps/:app_id/readme",
            "params": [
              {
                "name": "app_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "The app's markdown README only — avoids the heavyweight detail endpoint\n(which image-inlines the full html) just to render the README modal."
        },
        {
          "info": {
            "name": "List App Versions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/apps/:app_id/versions",
            "params": [
              {
                "name": "app_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Newest-first list of an app's versions — the agent-written change\nsummaries users review instead of raw source diffs. Visibility follows the\napp itself (``fetch_app_for_caller`` 404s an unshared app for guests)."
        },
        {
          "info": {
            "name": "Get App Version",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/apps/:app_id/versions/:version_number",
            "params": [
              {
                "name": "app_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "version_number",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Full detail (image-inlined html + readme) of ONE past version, for\npreviewing a snapshot in the AppFrame before deciding whether to restore."
        },
        {
          "info": {
            "name": "Restore App Version",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/apps/:app_id/versions/:version_number/restore",
            "params": [
              {
                "name": "app_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "version_number",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Revert the live app to a past snapshot. History stays append-only: the\nrestore is recorded as a NEW version (so it can itself be undone). Guests are\nblocked at the router level (guest_write_guard); any member may restore."
        }
      ]
    }
  ],
  "bundled": true
}