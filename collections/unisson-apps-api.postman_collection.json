        {
          "id": "b553c924-8b66-4854-9609-a292afb4cbad",
          "name": "List App Versions",
          "request": {
            "name": "List App Versions",
            "description": {
              "content": "Newest-first list of an app's versions — the agent-written change\nsummaries users review instead of raw source diffs. Visibility follows the\napp itself (``fetch_app_for_caller`` 404s an unshared app for guests).",
              "type": "text/plain"
            },
            "url": {
              "path": [
