{
  "opencollection": "1.0.0",
  "info": {
    "name": "Unisson agent-evals auth API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Current User Info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/auth/me",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get current user info from Clerk session"
        }
      ]
    }
  ],
  "bundled": true
}