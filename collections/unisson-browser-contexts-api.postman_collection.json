        {
          "id": "892e4fad-7b7e-42dc-a4ed-67b0181a8b88",
          "name": "Delete User Session",
          "request": {
            "name": "Delete User Session",
            "description": {
              "content": "Delete a user's saved authentication.\n\n- If domain is provided: Surgically removes auth for that specific domain\n  (starts a Kernel browser session to filter cookies, then persists)\n- If domain is not provided: Clears ALL auth by deleting the unified context\n\nUsers can delete their own session. Admins can delete any user's session.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "browser-contexts",
                "user",
                ":user_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "domain",
                  "value": "<string>",
                  "description": "Domain to revoke auth for. If not provided, clears ALL auth."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "user_id",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
