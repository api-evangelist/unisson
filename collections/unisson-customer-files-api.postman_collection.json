          "name": "Delete Customer File",
          "request": {
            "name": "Delete Customer File",
            "description": {
              "content": "Delete a generated file from the customer.\n\nMembers only — the guest write guard blocks this DELETE (it is not in\n``deps.py::_GUEST_WRITE_ALLOWLIST``). The provenance row keys the single\nphysical object, so deleting here also removes it from the originating\nagent/conversation workspace.",
              "type": "text/plain"
            },
