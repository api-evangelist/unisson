          "name": "List Email Drafts",
          "request": {
            "name": "List Email Drafts",
            "description": {
              "content": "List drafts for a conversation. Used by the FE on cold-load to\nrehydrate the inline cards after a refresh — without this, the card\nwould show the LLM's original args instead of the user's manual edits.",
              "type": "text/plain"
            },
            "url": {
