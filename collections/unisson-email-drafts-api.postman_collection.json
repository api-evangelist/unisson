                  "key": "conversation_id",
                  "value": "<uuid>",
                  "description": "(Required) Conversation to scope drafts to."
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Optional filter — usually 'pending'."
