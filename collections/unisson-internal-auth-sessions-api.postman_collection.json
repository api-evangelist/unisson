        {
          "id": "0daad015-2775-4064-a2c1-8192d729222e",
          "name": "Get Connection Status",
          "request": {
            "name": "Get Connection Status",
            "description": {
              "content": "Token-authenticated mirror of ``/managed-auth/connect/{id}/status``.\n\nUsed by the raw-liveview UI on ``/auth/m/{token}`` to detect login\ncompletion. Token is the credential — same model as ``/bootstrap`` and\n``/finalize``.\n\nDeliberately does NOT call ``record_authenticated_domain`` like the\nClerk-authed sibling does: the run's auth-pause resume in\n``browser_agent_runner`` already records the domain after ``/finalize``\nflips the run to ``pending`` and ``enqueue_run_execution`` runs.\n\nMostly a read endpoint, but when Kernel reports the connection no\nlonger exists we eagerly fail the session + linked run rather than\nleak it to the periodic sweeper — otherwise the run would sit in\n``authentication_required`` until ``expires_at``, with the polling\nclient stopped and unable to recover.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "internal",
                "auth-sessions",
                ":token",
                "connection-status"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "token",
                  "description": "(Required) "
                }
              ]
            },
