          "request": {
            "name": "Finalize Auth Session",
            "description": {
              "content": "Called by the page once the React component reports success / error.\n\nOn success: flips the linked run from authentication_required → pending\nand enqueues the same background execution /external/runs would have\nenqueued on a happy-path call. Idempotent: a second call returns 409.",
              "type": "text/plain"
            },
