{
  "opencollection": "1.0.0",
  "info": {
    "name": "Unisson agent-evals managed-auth API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "managed-auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Connection",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/managed-auth/connect",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a Kernel Managed Auth connection and start the login flow.\n\nReturns a hosted URL where the user can authenticate."
        },
        {
          "info": {
            "name": "Get Connection Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/managed-auth/connect/:connection_id/status",
            "params": [
              {
                "name": "connection_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Poll the status of a Kernel Managed Auth connection.\n\nWhen status is AUTHENTICATED, the domain is automatically recorded in the DB."
        },
        {
          "info": {
            "name": "Cancel Connection",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/managed-auth/connect/:connection_id",
            "params": [
              {
                "name": "connection_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Cancel an in-progress Kernel Managed Auth login flow."
        }
      ]
    }
  ],
  "bundled": true
}