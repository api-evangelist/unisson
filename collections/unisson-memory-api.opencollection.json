{
  "opencollection": "1.0.0",
  "info": {
    "name": "Unisson agent-evals memory API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "memory",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Memory Files",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/memory",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List all memory files: the account file, then every member's file."
        },
        {
          "info": {
            "name": "Get Account Memory",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/memory/account",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "The org's account-level memory file (get-or-create)."
        },
        {
          "info": {
            "name": "Update Account Memory",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/memory/account",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Edit the account file (members only; versioned as ``manual``)."
        },
        {
          "info": {
            "name": "Get My Memory",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/memory/me",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "The caller's own memory file (get-or-create)."
        },
        {
          "info": {
            "name": "Get User Memory",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/memory/users/:user_id",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "A member's memory file (get-or-create). Any member may view any file."
        },
        {
          "info": {
            "name": "Update User Memory",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/memory/users/:user_id",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Edit a member's memory file (any member may edit any file; versioned as\n``manual``)."
        },
        {
          "info": {
            "name": "List Memory Versions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/memory/:memory_file_id/versions",
            "params": [
              {
                "name": "memory_file_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "A memory file's content version history, newest first."
        },
        {
          "info": {
            "name": "Get Memory Version",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/memory/:memory_file_id/versions/:version_id",
            "params": [
              {
                "name": "memory_file_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "version_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "A single content version (full text)."
        },
        {
          "info": {
            "name": "Revert Memory Version",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/memory/:memory_file_id/versions/:version_id/revert",
            "params": [
              {
                "name": "memory_file_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "version_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Restore a memory file to a prior version (members only). Appends a new\n``revert`` version — history is never rewritten."
        }
      ]
    }
  ],
  "bundled": true
}