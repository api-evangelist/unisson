{
  "opencollection": "1.0.0",
  "info": {
    "name": "Unisson agent-evals onboarding API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "onboarding",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Onboarding Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/onboarding/status",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get current onboarding status for the user's organization."
        },
        {
          "info": {
            "name": "Complete Onboarding",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/onboarding/complete",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Mark onboarding as complete and save organization settings."
        }
      ]
    }
  ],
  "bundled": true
}