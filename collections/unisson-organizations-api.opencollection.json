        },
        {
          "info": {
            "name": "Generate Identity Secret",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/organizations/me/api-keys/:key_id/generate-identity-secret",
            "params": [
