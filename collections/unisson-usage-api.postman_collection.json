          "name": "Get Usage Stats",
          "request": {
            "name": "Get Usage Stats",
            "description": {
              "content": "Get usage statistics for the current organization.\n\nReturns:\n- Run duration in seconds (sum of all non-sub runs) for the filtered period\n- Per-user breakdown of runs and duration for the filtered period\n- Daily usage breakdown for the filtered period (or hourly if day is specified)",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "usage",
                "stats"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "year",
                  "value": "<integer>",
                  "description": "Filter by year"
                },
                {
                  "disabled": false,
                  "key": "month",
                  "value": "<integer>",
                  "description": "Filter by month (1-12)"
                },
                {
                  "disabled": false,
                  "key": "day",
                  "value": "<integer>",
                  "description": "Filter by day (1-31) - returns hourly breakdown"
                },
                {
                  "disabled": false,
                  "key": "timezone",
                  "value": "<string>",
                  "description": "Timezone for hourly breakdown (e.g., 'America/Los_Angeles')"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
