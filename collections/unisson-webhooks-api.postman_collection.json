          "name": "Clerk Webhook",
          "request": {
            "name": "Clerk Webhook",
            "description": {
              "content": "Handle Clerk webhook events\n\nEvents handled:\n- organization.created: Create organization in our database\n- organization.updated: Update organization in our database\n- organization.deleted: Delete organization from our database\n- organizationMembership.created: Link user to organization\n- organizationMembership.updated: Update user role\n- organizationMembership.deleted: Unlink user from organization\n- user.created: Create user in our database\n- user.updated: Update user in our database\n- user.deleted: Delete user from our database",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
